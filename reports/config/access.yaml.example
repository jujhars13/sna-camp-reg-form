# Which Google accounts can see which camp reports.
# Copy to access.yaml and mount it into the reports container.
# Camp keys are the `name` field from app/src/data/*.json; "*" means every camp.
# Emails are matched case-insensitively. Edits are picked up without a restart.
users:
  jujhar@goodstack.io:
    camps: ["*"]
  camp.leader@example.com:
    camps:
      - west-bromwich-2026-10-29
      - stratford-road-2026-08-10
